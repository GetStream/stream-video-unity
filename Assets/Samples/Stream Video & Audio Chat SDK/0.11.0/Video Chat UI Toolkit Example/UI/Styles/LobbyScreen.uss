.lobby {
    flex-grow: 1;
}

.lobby__body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 0 16px 48px 16px;
}

.lobby__intro {
    align-items: center;
    margin-bottom: 24px;
}

.app-root .lobby__globe {
    width: 24px;
    height: 24px;
    margin-bottom: 12px;
    -unity-background-image-tint-color: var(--color-accent);
}

.lobby__title {
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.lobby__main {
    width: 100%;
    max-width: 420px;
    flex-direction: column;
}

.lobby__preview-area {
    align-items: center;
    justify-content: center;
}

/* Width and height are set from code to keep the preview aspect ratio */
.lobby__preview {
    flex-shrink: 0;
}

.lobby__side {
    align-items: stretch;
}

.lobby__controls {
    flex-direction: row;
    justify-content: center;
    margin: 12px 0 16px 0;
}

.app-root .lobby__controls .btn-circle {
    margin: 0 4px;
}

/* Device dropdowns. Selectors are scoped to .app-root so they win over the default theme's field states */
.lobby__devices {
    flex-direction: row;
    margin-bottom: 28px;
}

.lobby__device {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}

.lobby__device--last {
    margin-right: 0;
}

.app-root .lobby__device-icon {
    position: absolute;
    left: 12px;
    top: 10px;
    -unity-background-image-tint-color: var(--color-text-secondary);
}

.app-root .lobby__device-dropdown {
    flex-grow: 1;
    margin: 0;
}

.app-root .lobby__device-dropdown > .unity-base-popup-field__input,
.app-root .lobby__device-dropdown:hover > .unity-base-popup-field__input,
.app-root .lobby__device-dropdown:focus > .unity-base-popup-field__input,
.app-root .lobby__device-dropdown:hover:enabled > .unity-base-popup-field__input,
.app-root .lobby__device-dropdown:focus:enabled > .unity-base-popup-field__input {
    height: 40px;
    margin: 0;
    padding: 0 10px 0 38px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--color-border);
    background-color: var(--color-bg);
}

.app-root .lobby__device-dropdown .unity-base-popup-field__text {
    flex-shrink: 1;
    color: var(--color-text-primary);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.app-root .lobby__device-dropdown .unity-base-popup-field__arrow {
    width: 20px;
    height: 20px;
    margin-left: 4px;
    background-image: url("../Icons/icon_expand_more.png");
    -unity-background-image-tint-color: var(--color-text-secondary);
}

.lobby__error {
    color: var(--color-danger);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.app-root .lobby__intro--landscape {
    display: none;
}

/* Landscape: preview on the left, title and actions on the right */
.app-root.landscape .lobby__intro--portrait {
    display: none;
}

.app-root.landscape .lobby__intro--landscape {
    display: flex;
}

.landscape .lobby__body {
    padding-bottom: 16px;
}

.landscape .lobby__main {
    flex-grow: 1;
    max-width: 960px;
    flex-direction: row;
    align-items: center;
}

.landscape .lobby__preview-area {
    flex-grow: 1;
    flex-basis: 0;
    align-self: stretch;
}

.landscape .lobby__side {
    width: 300px;
    margin-left: 24px;
    justify-content: center;
}
